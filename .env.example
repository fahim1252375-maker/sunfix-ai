# GEMINI_API_KEY: Required for Gemini AI API calls if any server-side utilities are enabled.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Firebase App Check (Recommended for Firebase AI Logic production attestation)
# Obtain your reCAPTCHA Enterprise site key from Google Cloud / Firebase Console -> App Check.
VITE_RECAPTCHA_SITE_KEY=""

# Optional: Firebase App Check debug token for local development ONLY.
# Never commit a real debug token. Set to "true" to generate one in browser console,
# or provide your registered debug token UUID during local testing.
VITE_FIREBASE_APPCHECK_DEBUG_TOKEN=""
