# Firebase Web App configuration (Firebase Console -> Project settings -> Your apps).
# These are public client values, not Admin SDK credentials.
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""
VITE_FIREBASE_MEASUREMENT_ID=""
# Use (default) for the local emulator. For live Firebase, use the exact database ID shown in Cloud Firestore.
VITE_FIRESTORE_DATABASE_ID="(default)"
VITE_FIREBASE_AI_MODEL="gemini-3.5-flash-lite"

# Never expose a Gemini secret in a VITE_* variable or commit it.
# Use Firebase AI Logic or a server-side secret manager for production.
GEMINI_API_KEY=""

# App Check: reCAPTCHA Enterprise site key from Firebase Console -> App Check.
VITE_RECAPTCHA_SITE_KEY=""

# Local development only. Never commit a real App Check debug token.
VITE_FIREBASE_APPCHECK_DEBUG_TOKEN=""

# Local/test only: route Firebase SDK requests to the Firebase Emulator Suite.
# This switch is ignored by production builds.
VITE_USE_FIREBASE_EMULATORS="false"
VITE_FIREBASE_AUTH_EMULATOR_URL="http://127.0.0.1:9099"
VITE_FIREBASE_FIRESTORE_EMULATOR_HOST="127.0.0.1"
VITE_FIREBASE_FIRESTORE_EMULATOR_PORT="8080"
