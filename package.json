{
  "name": "sunfix-field",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit",
    "test": "tsx --test src/utils/*.test.ts src/components/*.test.ts src/services/*.test.ts firestore.rules.test.ts",
    "lint:eslint": "eslint .",
    "check": "npm run lint && npm run lint:eslint && npm test && npm run build",
    "test:rules:integration": "tsx --test tests/firestore.rules.emulator.test.ts",
    "test:rules": "bunx firebase-tools@15.37.0 emulators:exec --config firebase.emulator.json --only firestore --project demo-sunfix-field \"bun run test:rules:integration\"",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@firebase/eslint-plugin-security-rules": "^0.0.2",
    "@google/genai": "^2.4.0",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "@tailwindcss/vite": "^4.3.3",
    "@types/qrcode": "^1.5.6",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^6.1.1",
    "dotenv": "^17.2.3",
    "eslint": "^10.15.0",
    "firebase": "^13.4.0",
    "jspdf": "^4.2.1",
    "jsqr": "^1.4.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "qrcode": "^1.5.4",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "recharts": "^3.11.1",
    "three": "^0.187.0",
    "vite": "^8.3.0",
    "vite-plugin-pwa": "^2.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "@firebase/rules-unit-testing": "^4.0.1",
    "@axe-core/playwright": "^4.10.2",
    "@playwright/test": "^1.56.1",
    "fake-indexeddb": "^6.2.4"
  },
  "packageManager": "bun@1.4.5",
  "engines": {
    "node": ">=24.12.0"
  }
